struct SampleInfo {
    std::string name;
    std::string type;
    std::string label;
    std::string colorHex;
    std::vector<std::string> files;
};

struct HistInfo {
    std::string key_path;     // ROOT internal path, e.g. "CutflowKinematics/cutflow_w"
    std::string clean_name;   // sanitized file-system name (no slashes, no spaces)
};

