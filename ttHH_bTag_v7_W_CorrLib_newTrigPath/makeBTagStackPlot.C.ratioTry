// makeBTagStackPlot.C
//
// Usage:
//   root -l -q makeBTagStackPlot.C
//
// Reads Data and MC ROOT files and draws stacked histograms with a Data/MC ratio panel.

#include <TFile.h>
#include <TH1F.h>
#include <THStack.h>
#include <TCanvas.h>
#include <TLegend.h>
#include <TLine.h>
#include <TString.h>
#include <TMath.h>
#include <TStyle.h>
#include <vector>
#include <iostream>

struct SampleInfo {
    TString name;
    int color;
    TString displayName;
};

// Returns the list of MC samples to include
std::vector<SampleInfo> getSampleList() {
    return {
    // 색상과 표시 이름 설정
    // QCD HT별로 쪼개기
    {"QCD_HT200to300", kYellow-9, "QCD HT200-300"},
////ack({"QCD_HT300to500", kYellow-7, "QCD HT300-500"})
    {"QCD_HT500to700", kYellow-5, "QCD HT500-700"},
    {"QCD_HT700to1000", kYellow-3, "QCD HT700-1000"},
    {"QCD_HT1000to1500", kYellow, "QCD HT1000-1500"},
    {"QCD_HT1500to2000", kOrange-9, "QCD HT1500-2000"},
    {"QCD_HT2000toInf", kOrange-7, "QCD HT2000-Inf"},

    {"ttJets", kRed-7, "t#bar{t}+jets"},
    {"ttbb", kRed-9, "t#bar{t}+b#bar{b}"},
    {"tt4b", kRed-10, "t#bar{t}+4b"},
    {"ttHH", kBlue-9, "t#bar{t}HH"},
    {"ttHtobb", kBlue-7, "t#bar{t}H(b#bar{b})"},
    {"tttt", kGreen-7, "t#bar{t}t#bar{t}"},
    {"tttW", kGreen-5, "t#bar{t}tW"},
    {"ttWH", kCyan-3, "t#bar{t}WH"},
    {"ttWW", kCyan-5, "t#bar{t}WW"},
    {"ttWZ", kCyan-7, "t#bar{t}WZ"},
    {"ttZHto4b", kViolet-5, "t#bar{t}ZH(4b)"},
    {"ttZtobb", kViolet-7, "t#bar{t}Z(b#bar{b})"}
////    samples.push_back({"ttZZto4b", kViolet-9, "t#bar{t}ZZ(4b)"});

    };
}

void makeBTagStackPlot() {
    // Base directory containing Reweight_*.root files
    TString baseDir = "ScaleFactors/ReweightApplied";
    // Histogram name inside each ROOT file
    TString histName = "h_nJets_noSF";  // <-- set your histogram name here

    // Open Data file and retrieve histogram
    TFile* fData = TFile::Open(baseDir + "/Reweight_Data.root");
    if (!fData || fData->IsZombie()) {
        std::cerr << "Error: Cannot open Data file at " << baseDir << "/Reweight_Data.root" << std::endl;
        return;
    }
    TH1F* hData = dynamic_cast<TH1F*>(fData->Get(histName));
    if (!hData) {
        std::cerr << "Error: Histogram '" << histName << "' not found in Data file" << std::endl;
        fData->Close();
        return;
    }
    hData->SetDirectory(0);
    fData->Close();

    // Define SF types and labels
    std::vector<TString> sfTypes  = {"noSF", "withSF", "reweight"};
    std::vector<TString> sfLabels = {"SF not applied", "SF applied", "SF+Reweight applied"};

    auto samples = getSampleList();

    // Loop over SF scenarios
    for (size_t iSF = 0; iSF < sfTypes.size(); ++iSF) {
        TString sfType  = sfTypes[iSF];
        TString sfLabel = sfLabels[iSF];

        // Create canvas with two pads
        TCanvas* c = new TCanvas("c", sfLabel, 800, 800);
        c->Divide(1, 2);

        //--- Top pad for stack plot
        c->cd(1);
        gPad->SetPad(0.0, 0.35, 1.0, 1.0);
        gPad->SetLogy(1);
        gPad->SetBottomMargin(0.02);
        gPad->SetTopMargin(0.08);
        gPad->SetRightMargin(0.05);
        gPad->SetLeftMargin(0.125);
        gPad->SetGridx();
        gPad->Modified(); gPad->Update();

        THStack* stack = new THStack("stack", "");
        std::vector<TH1F*> histos;
        double totalMC = 0;

        // Retrieve MC histograms
        for (const auto &info : samples) {
            TString fileName = baseDir + "/MC/Reweight_" + info.name + ".root";
            TFile* fMC = TFile::Open(fileName);
            if (!fMC || fMC->IsZombie()) {
                std::cerr << "Warning: Cannot open file " << fileName << std::endl;
                continue;
            }
            TH1F* hMC = dynamic_cast<TH1F*>(fMC->Get(histName));
            fMC->Close();
            if (!hMC) {
                std::cerr << "Warning: '" << histName << "' not found in " << fileName << std::endl;
                continue;
            }
            hMC->SetDirectory(0);
            hMC->SetFillColor(info.color);
            hMC->SetLineColor(info.color);
            stack->Add(hMC);
            histos.push_back(hMC);
            totalMC += hMC->Integral();
        }

        // Legend
        TLegend* leg = new TLegend(0.65, 0.70, 0.88, 0.88);
        leg->SetBorderSize(0); leg->SetFillStyle(0);
        leg->AddEntry(hData, "Data", "lep");
        for (size_t i = 0; i < histos.size(); ++i) {
            leg->AddEntry(histos[i], samples[i].displayName, "f");
        }

        // Draw stack and data
        stack->Draw("HIST");
        hData->Draw("E SAME");
        leg->Draw();

        std::cout << "Data integral: " << hData->Integral() << std::endl;
        std::cout << "MC total integral: " << totalMC << std::endl;

        //--- Bottom pad for ratio
        c->cd(2);
        gPad->SetPad(0.0, 0.0, 1.0, 0.35);
        gPad->SetBottomMargin(0.35);
        gPad->SetTopMargin(0.02);
        gPad->SetRightMargin(0.05);
        gPad->SetLeftMargin(0.125);
        gPad->SetGridx(); gPad->SetGridy();
        gPad->Modified(); gPad->Update();

        TH1F* hMCTot = dynamic_cast<TH1F*>(stack->GetStack()->Last()->Clone("hMCTot"));
        hMCTot->SetDirectory(0);
        TH1F* hRatio = dynamic_cast<TH1F*>(hData->Clone("hRatio"));
        hRatio->SetDirectory(0);
        hRatio->Divide(hMCTot);
        hRatio->SetMarkerStyle(20); hRatio->SetLineColor(kBlack);
        hRatio->SetStats(0);
        hRatio->GetYaxis()->SetTitle("Data/MC");
        hRatio->GetYaxis()->SetNdivisions(505);
        hRatio->GetYaxis()->SetTitleSize(0.1);
        hRatio->GetYaxis()->SetLabelSize(0.08);
        hRatio->GetXaxis()->SetLabelSize(0.08);
        hRatio->Draw("E0");

        TLine* line = new TLine(hRatio->GetXaxis()->GetXmin(), 1.0,
                                hRatio->GetXaxis()->GetXmax(), 1.0);
        line->SetLineStyle(2);
        line->Draw();

        // Save
        c->SaveAs("stack_" + sfType + ".png");
    }
}
