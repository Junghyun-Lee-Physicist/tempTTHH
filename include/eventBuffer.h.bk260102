  //--------------------------------------------------------------------------
  // Constructor: Write-Only
  //--------------------------------------------------------------------------
  eventBuffer(otreestream& stream)
  : input(0), output(&stream)
  {
    initBuffers();
        output->add("Events/Flag_BadPFMuonDzFilter", Flag_BadPFMuonDzFilter);
    output->add("Events/Flag_BadPFMuonFilter", Flag_BadPFMuonFilter);
