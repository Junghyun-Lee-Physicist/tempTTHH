// makeBTagReweightPlot.C
//
// 사용법:
//   root -l -q makeBTagReweightPlot.C   또는
//   root -l
//     .x makeBTagReweightPlot.C("ttJets")
//
// 이 매크로는 "Reweight_<SampleName>.root" 파일 내의 이벤트 레벨 히스토그램들
//   h_nJets_noSF, h_nJets_withSF, h_nJets_reweight,
//   h_nbJets_noSF, h_nbJets_withSF, h_nbJets_reweight,
//   h_HT_noSF, h_HT_withSF, h_HT_reweight
// 를 불러와서, 각 변수에 대해 상단 패드에는 SF 적용 및 SF+Reweight 적용 히스토그램을,  
// 하단 패드에는 각각의 비율 (SF/noSF, (SF+Reweight)/noSF)을 그린 후, PDF 파일로 저장합니다.
// nJets의 경우 x축은 6부터 15까지 표시되며, ratio plot의 y축 범위는 0.5~5로 설정됩니다.

#include <TFile.h>
#include <TH1F.h>
#include <TCanvas.h>
#include <TLegend.h>
#include <TString.h>
#include <TMath.h>
#include <TStyle.h>
#include <iostream>


void DrawCMSLabel()
{
    double x = 0.10, y = 0.925, fontSize = 0.060;
    std::string extraText = "Private work";

    TLatex latex;
    latex.SetNDC();
    latex.SetTextSize(fontSize);
    latex.SetTextAlign(11);
    TString text = Form("CMS#scale[0.5]{ }#scale[0.85]{#font[52]{%s}}", extraText.c_str());
    latex.DrawLatex(x, y, text);

}

void DrawCurrentSample()
{

    double x = 0.623, y = 0.925, fontSize = 0.050;
    std::string extraText = "2017 UL NanoAODv9";

    TLatex latex;
    latex.SetNDC();
    latex.SetTextSize(fontSize);
    latex.SetTextAlign(11);
    TString text = Form("#bf{%s}", extraText.c_str());
    latex.DrawLatex(x, y, text);
}

void DrawText(TString sampleName_)
{
    TPaveText *pt = new TPaveText(0.15, 0.68, 0.48, 0.85, "NDC");

    pt->AddText("#it{ttHH} hadronic channel");
    pt->AddText(Form("#it{sample: %s}", sampleName_.Data() ));
    //pt->AddText("Only the framework is different");
    pt->SetTextSize(0.05);
    pt->SetFillColor(0);        // 박스 배경색 (0: 투명)
    pt->SetTextColor(kBlack);   // 텍스트 색상
    pt->Draw();
}


// -------------------------------------------------------
// 함수: drawEventLevelPlot
// 주어진 두 히스토그램(예: SF 적용과 SF+Reweight 적용)을 상단 패드에 오버레이하고,
// 기준이 되는 NoSF 히스토그램과의 ratio plot을 하단 패드에 그린 후, PDF 파일로 저장.
// ratio plot의 y축 범위는 0.5 ~ 5로 설정하며, stat box는 제거되고, Sumw2()가 적용되어 있습니다.
// -------------------------------------------------------
void drawEventLevelPlot(TH1F* hNoSF, TH1F* hSF, TH1F* hRew, TH1F* hData, TString varName, TString sampleName, TString outDir = ".")
{
    if (!hNoSF || !hSF || !hRew) {
        std::cout << "[drawEventLevelPlot] Invalid histogram pointer(s) for " << varName << std::endl;
        return;
    }
    
    // Ensure errors are computed
    hNoSF->Sumw2();
    hSF->Sumw2();
    hRew->Sumw2();
    hData->Sumw2();

    //// 특별히 nJets의 경우, x축 범위를 6~15로 설정
    //if (varName == "nJets") {
    //    hNoSF->GetXaxis()->SetRangeUser(6, 15);
    //    hSF->GetXaxis()->SetRangeUser(6, 15);
    //    hRew->GetXaxis()->SetRangeUser(6, 15);
    //}
    
    // stat box 제거
    gStyle->SetOptStat(0);
    
    // 상단 패드: SF 적용과 SF+Reweight 적용 히스토그램을 오버레이
    TCanvas* c = new TCanvas("c", "Event Level Plot", 800, 800);
    c->SetLeftMargin(0.125);

    c->Divide(1,2);
    
    // 상단 패드
    c->cd(1);
    gPad->SetPad(0.0, 0.35, 1.0, 1.0);
    gPad->SetLogy(1);
    gPad->SetBottomMargin(0.005);
    gPad->SetGridx();
    gPad->Draw();

    hNoSF->SetLineColor(kBlack);
    hNoSF->SetMarkerStyle(22);
    hNoSF->SetMarkerColor(kBlack);
    hNoSF->GetYaxis()->SetTitle("# of Events (Log-scale)");
    hNoSF->GetYaxis()->SetTitleSize(0.055);
    hNoSF->GetYaxis()->SetTitleOffset(0.80);
    hNoSF->GetYaxis()->SetLabelSize(0.04);
    hNoSF->GetXaxis()->SetTitleSize(0); // x라벨은 ratio패드에서
    hNoSF->GetXaxis()->SetLabelSize(0); // x라벨은 ratio패드에서
    hNoSF->SetMarkerSize(1.1);

    double yMax  = hSF->GetMaximum();
    yMax *= 10.0;
    hNoSF->SetMaximum(yMax);

    hNoSF->Draw("E");
    // Draw SF histogram in blue
    hSF->SetLineColor(kBlue);
    hSF->SetMarkerStyle(20);
    hSF->SetMarkerColor(kBlue);
    hSF->SetMarkerSize(1.1);
    hSF->Draw("E SAME");
    // Draw SF+Reweight histogram in red on top
    hRew->SetLineColor(kRed);
    hRew->SetMarkerStyle(23);
    hRew->SetMarkerColor(kRed);
    hRew->SetMarkerSize(1.1);
    hRew->Draw("E SAME");
    
    // 범례
    TLegend* leg = new TLegend(0.54, 0.60, 0.85, 0.85);
    leg->AddEntry(hNoSF, "#bf{SF not applied}", "p");
    leg->AddEntry(hSF, "#bf{SF applied}", "p");
    leg->AddEntry(hRew, "#bf{SF+Reweight applied}", "p");
    leg->SetBorderSize(0);
    leg->SetTextFont(42);
    leg->SetTextAlign(12);
    leg->SetFillStyle(0);
    leg->Draw("same");
 
    DrawText(sampleName);
    DrawCMSLabel();
    DrawCurrentSample();

    for (int bin = 1; bin <= hNoSF->GetNbinsX(); bin++) {
        double bin_center = hNoSF->GetXaxis()->GetBinCenter(bin);
        double NoSF  = hNoSF->GetBinContent(bin);
        double SF    = hSF->GetBinContent(bin);
        double SFRew = hRew->GetBinContent(bin);

        //if(varName == "nJets") {
        //   cout<<"Bin --> " <<bin<<endl;
        //   cout<<"    NoSF, SF, Reweight  -->  "<<NoSF<<", "<<SF<<", "<<SFRew<<endl;
	//   cout<<endl;
	//}
    }


    // 하단 패드: Ratio plot
    c->cd(2);
    gPad->SetBottomMargin(0.3);
    gPad->SetPad(0.0, 0.0, 1.0, 0.35);
    gPad->SetGridx();

    TH1F* hRatio_NoSF = (TH1F*) hData->Clone("hData_NoSF");
    hRatio_NoSF->Divide(hNoSF);
    hRatio_NoSF->SetLineColor(kBlack);
    hRatio_NoSF->SetMarkerColor(kBlack);
    hRatio_NoSF->SetMarkerStyle(22);
    hRatio_NoSF->SetMarkerSize(1.1);
    //hRatio_NoSF->GetXaxis()->SetTitle("");
    gStyle->SetOptTitle(0);
    //hRatio_NoSF->GetXaxis()->SetTitle("bTagDeepFlavB"); //matched
    //hRatio_NoSF->GetXaxis()->SetTitle("HT"); //matched
    hRatio_NoSF->GetXaxis()->SetTitleOffset(1.1);
    hRatio_NoSF->GetXaxis()->SetTitleSize(0.5);
    hRatio_NoSF->GetYaxis()->SetTitle("Data/MC");
    hRatio_NoSF->GetYaxis()->SetTitleOffset(0.52);
    hRatio_NoSF->GetYaxis()->SetTitleSize(0.09);
    hRatio_NoSF->GetYaxis()->SetLabelSize(0.08);
    hRatio_NoSF->GetYaxis()->SetLabelOffset(0.01);
    hRatio_NoSF->GetYaxis()->SetNdivisions(804);
    hRatio_NoSF->GetXaxis()->SetLabelSize(0.08);
    hRatio_NoSF->GetXaxis()->SetLabelOffset(0.03);
    hRatio_NoSF->GetXaxis()->SetTitleSize(0.12);   
 
    // 설정된 범위의 첫 번째 및 마지막 bin 찾기
    int first_bin = hNoSF->GetXaxis()->GetFirst();
    int last_bin  = hNoSF->GetXaxis()->GetLast();

    // 해당 bin의 실제 X값 가져오기
    double upperPad_xmin = hNoSF->GetXaxis()->GetBinLowEdge(first_bin);
    double upperPad_xmax = hNoSF->GetXaxis()->GetBinUpEdge(last_bin);

    hRatio_NoSF->GetXaxis()->SetRangeUser(upperPad_xmin, upperPad_xmax); //matched

    //hRatio_NoSF->GetXaxis()->SetRangeUser(500.0, 2000.0); //matched
    //hRatio_NoSF->SetMinimum(0.0);
    //hRatio_NoSF->SetMaximum(23.0); //matched
    //hRatio_NoSF->SetMaximum(10.0); //matched


    // Ratio plots: (SF)/(NoSF) and (SF+Reweight)/(NoSF)
    TH1F* hRatio_SF = (TH1F*) hData->Clone("hData_SF");
    hRatio_SF->Divide(hSF);
    hRatio_SF->SetMarkerColor(kBlue);
    hRatio_SF->SetLineColor(kBlue);
    hRatio_SF->SetMarkerStyle(20);
    hRatio_SF->SetMarkerSize(1.1);
    hRatio_SF->GetXaxis()->SetTitle(varName);
    
    TH1F* hRatio_Rew = (TH1F*) hData->Clone("hData_Rew"); // Rew --> reweight
    hRatio_Rew->Divide(hRew);
    hRatio_Rew->SetMarkerColor(kRed);
    hRatio_Rew->SetLineColor(kRed);
    hRatio_Rew->SetMarkerStyle(23);
    hRatio_Rew->SetMarkerSize(1.1);


    double lowerPad_ymax = std::max(hRatio_NoSF->GetMaximum(),
                                std::max(hRatio_SF->GetMaximum(),
                                         hRatio_Rew->GetMaximum()));
    hRatio_NoSF->SetMaximum(lowerPad_ymax*1.3); //matched
    hRatio_NoSF->SetMaximum(2.0); //matched

    //hRatio_NoSF->SetMaximum(2.0); //matched
    //hRatio_NoSF->SetMinimum(0.0); //matched

    hRatio_NoSF->Draw("E");
    hRatio_SF->Draw("E SAME");
    hRatio_Rew->Draw("E SAME");

    // 저장할 PDF 파일 이름: e.g., "BTagReweightPlot_ttJets_nJets.pdf"
    TString outPdfName = Form("BTagReweightPlot_%s_%s.pdf", sampleName.Data(), varName.Data());
    if (outDir != "") {
        outPdfName = outDir + "/" + outPdfName;
    }
    c->SaveAs(outPdfName);
    std::cout << "[drawEventLevelPlot] Saved canvas to " << outPdfName << std::endl;
    
    delete c;
    delete leg;
}

// -------------------------------------------------------
// 메인 역할 함수: produceBTagEventLevelPlots
// - 인자로 sampleName을 받아 해당 ROOT 파일("Reweight_<sampleName>.root")을 열고,
//   이벤트 레벨 히스토그램들을 모두 불러와서 각 변수에 대해 플롯을 생성합니다.
// -------------------------------------------------------
void produceBTagEventLevelPlots(TString sampleName = "ttJets")
{
    // 입력 파일: "Reweight_<sampleName>.root"
    TString path = "ScaleFactors/ReweightApplied";
    TString inFileName = path + "/Reweight_" + sampleName + ".root";
    TFile* fIn = TFile::Open(inFileName, "READ");
    if (!fIn || fIn->IsZombie()) {
        std::cerr << "[produceBTagEventLevelPlots] Cannot open file: " << inFileName << std::endl;
        return;
    }
    std::cout << "[produceBTagEventLevelPlots] Opened file: " << inFileName << std::endl;
    
    TFile* fData = TFile::Open( path + "/Reweight_Data.root");
    TH1F* h_nJets_data       = (TH1F*) fData->Get("h_nJets_reweight");
    TH1F* h_HT_data          = (TH1F*) fData->Get("h_HT_reweight");
    TH1F* h_jetPt_data_jet0  = (TH1F*) fData->Get("h_jetPt_reweight_jet0");
    TH1F* h_bTag_data_jet0   = (TH1F*) fData->Get("h_bTag_reweight_jet0");
    TH1F* h_jetPt_data_jet1  = (TH1F*) fData->Get("h_jetPt_reweight_jet1");
    TH1F* h_bTag_data_jet1   = (TH1F*) fData->Get("h_bTag_reweight_jet1");

    // 이벤트 레벨 히스토그램 불러오기 (모두 존재한다고 가정)
    TH1F* h_nJets_noSF    = (TH1F*) fIn->Get("h_nJets_noSF");
    TH1F* h_nJets_withSF  = (TH1F*) fIn->Get("h_nJets_withSF");
    TH1F* h_nJets_reweight= (TH1F*) fIn->Get("h_nJets_reweight");
    
    TH1F* h_HT_noSF    = (TH1F*) fIn->Get("h_HT_noSF");
    TH1F* h_HT_withSF  = (TH1F*) fIn->Get("h_HT_withSF");
    TH1F* h_HT_reweight= (TH1F*) fIn->Get("h_HT_reweight");
    
    TH1F* h_jetPt_noSF_jet0     = (TH1F*) fIn->Get("h_jetPt_noSF_jet0");
    TH1F* h_jetPt_withSF_jet0   = (TH1F*) fIn->Get("h_jetPt_withSF_jet0");
    TH1F* h_jetPt_reweight_jet0 = (TH1F*) fIn->Get("h_jetPt_reweight_jet0");
    TH1F* h_bTag_noSF_jet0     = (TH1F*) fIn->Get("h_bTag_noSF_jet0");
    TH1F* h_bTag_withSF_jet0   = (TH1F*) fIn->Get("h_bTag_withSF_jet0");
    TH1F* h_bTag_reweight_jet0 = (TH1F*) fIn->Get("h_bTag_reweight_jet0");

    TH1F* h_jetPt_noSF_jet1     = (TH1F*) fIn->Get("h_jetPt_noSF_jet1");
    TH1F* h_jetPt_withSF_jet1   = (TH1F*) fIn->Get("h_jetPt_withSF_jet1");
    TH1F* h_jetPt_reweight_jet1 = (TH1F*) fIn->Get("h_jetPt_reweight_jet1");
    TH1F* h_bTag_noSF_jet1     = (TH1F*) fIn->Get("h_bTag_noSF_jet1");
    TH1F* h_bTag_withSF_jet1   = (TH1F*) fIn->Get("h_bTag_withSF_jet1");
    TH1F* h_bTag_reweight_jet1 = (TH1F*) fIn->Get("h_bTag_reweight_jet1");


    if (!h_nJets_noSF || !h_nJets_withSF || !h_nJets_reweight ||
        !h_HT_noSF || !h_HT_withSF || !h_HT_reweight) {
        std::cerr << "[produceBTagEventLevelPlots] One or more event-level histograms are missing." << std::endl;
        fIn->Close();
        return;
    }
    
    // 각 히스토그램에 대해 Sumw2() 호출하여 에러 계산 활성화
    h_nJets_data      ->Sumw2(); 
    h_HT_data         ->Sumw2(); 
    h_jetPt_data_jet0 ->Sumw2(); 
    h_bTag_data_jet0  ->Sumw2(); 
    h_jetPt_data_jet1 ->Sumw2(); 
    h_bTag_data_jet1  ->Sumw2(); 

    h_nJets_noSF->Sumw2();    h_nJets_withSF->Sumw2();    h_nJets_reweight->Sumw2();
    h_HT_noSF->Sumw2();       h_HT_withSF->Sumw2();       h_HT_reweight->Sumw2();

    h_jetPt_noSF_jet0     ->Sumw2(); 
    h_jetPt_withSF_jet0   ->Sumw2();
    h_jetPt_reweight_jet0 ->Sumw2();
    h_bTag_noSF_jet0      ->Sumw2();
    h_bTag_withSF_jet0    ->Sumw2();
    h_bTag_reweight_jet0  ->Sumw2();
    h_jetPt_noSF_jet1     ->Sumw2(); 
    h_jetPt_withSF_jet1   ->Sumw2();
    h_jetPt_reweight_jet1 ->Sumw2();
    h_bTag_noSF_jet1      ->Sumw2();
    h_bTag_withSF_jet1    ->Sumw2();
    h_bTag_reweight_jet1  ->Sumw2();


    // stat box 제거
    gStyle->SetOptStat(0);
    
    // 출력 폴더 (원하는 경우)
    TString outDir = "plots";
    if (gSystem->AccessPathName(outDir.Data())) {
        gSystem->mkdir(outDir, kTRUE);
    }
    
    // 변수별 플롯 생성
    // (a) nJets: x축 [6,15]로 설정 (nJets 히스토그램은 x축을 수정)
    h_nJets_noSF->GetXaxis()->SetRangeUser(6, 15);
    h_nJets_withSF->GetXaxis()->SetRangeUser(6, 15);
    h_nJets_reweight->GetXaxis()->SetRangeUser(6, 15);
    drawEventLevelPlot(h_nJets_noSF, h_nJets_withSF, h_nJets_reweight, h_nJets_data, "nJets", sampleName, outDir);
    
    // (c) HT: 기본 x축 사용 (예: 0~2000 GeV)
    h_HT_noSF->GetXaxis()->SetRangeUser(500, 2000);
    h_HT_withSF->GetXaxis()->SetRangeUser(500, 2000);
    h_HT_reweight->GetXaxis()->SetRangeUser(500, 2000);
    drawEventLevelPlot(h_HT_noSF, h_HT_withSF, h_HT_reweight, h_HT_data, "HT", sampleName, outDir);


    h_jetPt_noSF_jet0->GetXaxis()->SetRangeUser(50, 400);
    h_jetPt_withSF_jet0->GetXaxis()->SetRangeUser(50, 400);
    h_jetPt_reweight_jet0->GetXaxis()->SetRangeUser(50, 400);
    drawEventLevelPlot(h_jetPt_noSF_jet0, h_jetPt_withSF_jet0,h_jetPt_reweight_jet0, h_jetPt_data_jet0, "jet0 pT", sampleName, outDir);

    h_jetPt_noSF_jet1->GetXaxis()->SetRangeUser(50, 400);
    h_jetPt_withSF_jet1->GetXaxis()->SetRangeUser(50, 400);
    h_jetPt_reweight_jet1->GetXaxis()->SetRangeUser(50, 400);
    drawEventLevelPlot(h_jetPt_noSF_jet1, h_jetPt_withSF_jet1,h_jetPt_reweight_jet1, h_jetPt_data_jet1, "jet1 pT", sampleName, outDir);

    h_bTag_noSF_jet0->GetXaxis()->SetRangeUser(0.0, 1.0);
    h_bTag_withSF_jet0->GetXaxis()->SetRangeUser(0.0, 1.0);
    h_bTag_reweight_jet0->GetXaxis()->SetRangeUser(0.0, 1.0);
    drawEventLevelPlot(h_bTag_noSF_jet0, h_bTag_withSF_jet0,h_bTag_reweight_jet0, h_bTag_data_jet0, "jet0 bTag discriminant", sampleName, outDir);

    h_bTag_noSF_jet1->GetXaxis()->SetRangeUser(0.0, 1.0);
    h_bTag_withSF_jet1->GetXaxis()->SetRangeUser(0.0, 1.0);
    h_bTag_reweight_jet1->GetXaxis()->SetRangeUser(0.0, 1.0);
    drawEventLevelPlot(h_bTag_noSF_jet1, h_bTag_withSF_jet1,h_bTag_reweight_jet1, h_bTag_data_jet1, "jet1 bTag discriminant", sampleName, outDir);

    
    fIn->Close();
    std::cout << "[produceBTagEventLevelPlots] All plots produced." << std::endl;
}

// -------------------------------------------------------
// 최종 매크로: main 함수 역할
// -------------------------------------------------------
void makeBTagReweightPlot(TString sampleName = "ttJets")
{
    produceBTagEventLevelPlots(sampleName);
}

