###############################################################################
# Tier3_2017_FH_unified_validation.yml
# -----------------------------------------------------------------------------
# Validation-study YAML for the ttHH(4b) FH analyzer.
#
# Each "scenario" entry under `validation_scenarios:` defines one independent
# condor batch (one combination of cut/SF toggles). The submit script
# (submit_job_FH_Tier3_unified.py, updated below) iterates over these and
# submits each as a separate condor batch with output_dir suffixed by the
# scenario name.
#
# Scenario fields:
#   name              : short tag, becomes part of every output_dir
#   nbJetsCut         : minimum nbJets cut at step 8;  -1 disables the cut
#   applyHadWWindow   : 30 < hadWMass < 250 cut on/off
#   applyHiggsWindow  : Higgs mass window on/off (currently unused in main;
#                       kept here for the future)
#   tightenJet8       : raise nJets cut to >=8 (default ≥7 in current cut map)
#   forceHiggsRecoMinBjets : minimum b-jets to attempt Higgs reco (default 4)
#   applyBtagShapeSF  : per-jet b-tag shape SF on/off
#   applyBtagNormSF   : per-process-group b-tag norm reweight on/off
#   applyTriggerSF    : trigger SF on/off
#   applyTopPtSF      : top-pT reweight on/off (placeholder; default OFF)
#   ttHVRStyle        : if true, applies preset (≥3 b-tag, no W/Higgs windows,
#                       all SFs ON). Overrides the individual fields above.
#
# To keep the YAML readable while supporting all needed studies we group
# scenarios by purpose:
#   GROUP A — current baseline (sanity check; identical to main mode result)
#   GROUP B — single-cut N-1 (turn off ONE cut at a time)
#   GROUP C — b-jet cut variation (≥0/1/2/3/4)
#   GROUP D — single-SF ablation
#   GROUP E — ttH VR style preset
###############################################################################

common:
  year: "2017"
  analysis_mode: "validation"   # NEW mode

# ----------------------------------------------------------------------------- 
# Validation scenario list
# -----------------------------------------------------------------------------
validation_scenarios:

  # ─── GROUP A: BASELINE ─────────────────────────────────────────────────────
  - name: baseline
    nbJetsCut: 4
    applyHadWWindow: true
    applyHiggsWindow: false
    tightenJet8: false
    forceHiggsRecoMinBjets: 4
    applyBtagShapeSF: true
    applyBtagNormSF: true
    applyTriggerSF: true
    applyTopPtSF: false
    ttHVRStyle: false

  # ─── GROUP B: SINGLE-CUT N-1 ───────────────────────────────────────────────
  - name: noBjetCut
    nbJetsCut: -1
    applyHadWWindow: true
    applyHiggsWindow: false
    tightenJet8: false
    forceHiggsRecoMinBjets: 4
    applyBtagShapeSF: true
    applyBtagNormSF: true
    applyTriggerSF: true
    applyTopPtSF: false
    ttHVRStyle: false

  - name: noHadWWindow
    nbJetsCut: 4
    applyHadWWindow: false
    applyHiggsWindow: false
    tightenJet8: false
    forceHiggsRecoMinBjets: 4
    applyBtagShapeSF: true
    applyBtagNormSF: true
    applyTriggerSF: true
    applyTopPtSF: false
    ttHVRStyle: false

  # ─── GROUP C: B-JET CUT VARIATION (key study for user's hypothesis) ────────
  - name: bcut0
    nbJetsCut: 0
    applyHadWWindow: true
    applyHiggsWindow: false
    tightenJet8: false
    forceHiggsRecoMinBjets: 4
    applyBtagShapeSF: true
    applyBtagNormSF: true
    applyTriggerSF: true
    applyTopPtSF: false
    ttHVRStyle: false

  - name: bcut1
    nbJetsCut: 1
    applyHadWWindow: true
    applyHiggsWindow: false
    tightenJet8: false
    forceHiggsRecoMinBjets: 4
    applyBtagShapeSF: true
    applyBtagNormSF: true
    applyTriggerSF: true
    applyTopPtSF: false
    ttHVRStyle: false

  - name: bcut2
    nbJetsCut: 2
    applyHadWWindow: true
    applyHiggsWindow: false
    tightenJet8: false
    forceHiggsRecoMinBjets: 4
    applyBtagShapeSF: true
    applyBtagNormSF: true
    applyTriggerSF: true
    applyTopPtSF: false
    ttHVRStyle: false

  - name: bcut3
    nbJetsCut: 3
    applyHadWWindow: true
    applyHiggsWindow: false
    tightenJet8: false
    forceHiggsRecoMinBjets: 4
    applyBtagShapeSF: true
    applyBtagNormSF: true
    applyTriggerSF: true
    applyTopPtSF: false
    ttHVRStyle: false

  # ─── GROUP D: SINGLE-SF ABLATION (key study for SF mis-calibration) ────────
  - name: noSF_all
    nbJetsCut: 4
    applyHadWWindow: true
    applyHiggsWindow: false
    tightenJet8: false
    forceHiggsRecoMinBjets: 4
    applyBtagShapeSF: false
    applyBtagNormSF: false
    applyTriggerSF: false
    applyTopPtSF: false
    ttHVRStyle: false

  - name: noBtagShape
    nbJetsCut: 4
    applyHadWWindow: true
    applyHiggsWindow: false
    tightenJet8: false
    forceHiggsRecoMinBjets: 4
    applyBtagShapeSF: false
    applyBtagNormSF: true
    applyTriggerSF: true
    applyTopPtSF: false
    ttHVRStyle: false

  - name: noBtagNorm
    nbJetsCut: 4
    applyHadWWindow: true
    applyHiggsWindow: false
    tightenJet8: false
    forceHiggsRecoMinBjets: 4
    applyBtagShapeSF: true
    applyBtagNormSF: false
    applyTriggerSF: true
    applyTopPtSF: false
    ttHVRStyle: false

  - name: noTrigSF
    nbJetsCut: 4
    applyHadWWindow: true
    applyHiggsWindow: false
    tightenJet8: false
    forceHiggsRecoMinBjets: 4
    applyBtagShapeSF: true
    applyBtagNormSF: true
    applyTriggerSF: false
    applyTopPtSF: false
    ttHVRStyle: false

  # ─── GROUP E: ttH VR STYLE ─────────────────────────────────────────────────
  - name: ttHVR
    ttHVRStyle: true     # preset; other fields ignored
    # The C++ side calls applyTtHVRPreset() which internally sets:
    #   nbJetsCut = 3,  applyHadWWindow = false,  applyHiggsWindow = false,
    #   forceHiggsRecoMinBjets = 4,  all SFs ON.

# -----------------------------------------------------------------------------
# Sample list (identical to the main analyzer YAML).
# -----------------------------------------------------------------------------
